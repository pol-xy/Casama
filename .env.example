# Casama Supabase environment configuration
# Pass these via `--dart-define` (or `.env` on desktop/mobile dev)
# NEVER put SUPABASE_SERVICE_ROLE_KEY in client builds or `.env`.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: enables "One-Tap Demo Login" on AuthScreen using a live Supabase user
SUPABASE_DEMO_EMAIL=
SUPABASE_DEMO_PASSWORD=
